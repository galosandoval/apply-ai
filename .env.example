# Postgres connection string. `./start-database.sh` starts a local container.
DATABASE_URL="postgresql://postgres:password@localhost:5432/apply-ai"

# Origin the app is served from. better-auth signs callbacks against it.
APP_URL="http://localhost:3000"
# `openssl rand -base64 32`
BETTER_AUTH_SECRET=""

OPENAI_API_KEY=""

# Separate database used by the router integration tests. Its schema is
# migrated on connect and its rows are deleted between tests, so never point
# this at a database you care about.
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5433/apply-ai-test"
